From: Karven <karven@atomicmail.io>
Date: Sat, 24 Oct 2026 01:48:26 +0700
Subject: [PATCH] feat: Implement pose module


diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index fd0b9f20fbdd523d51550fd6009b5011e6e7e6e6..6eec1bd5585d0bf6c631307d33e0a0254242019b 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1372,11 +1372,33 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
             }
         }
 
+        private static final int POSE_INDEX = 6; // LaglessPurpur - pose index for entity data packet
         @Override
         public void sendToTrackingPlayersAndSelf(final Packet<? super ClientGamePacketListener> packet) {
             this.sendToTrackingPlayers(packet);
             if (this.entity instanceof ServerPlayer player) {
-                player.connection.send(packet);
+                // Lagless start - Implement pose module: cancel self pose updates
+                //player.connection.send(packet);
+                if (
+                        !me.karven.lagless.module.MinecraftLaglessModules.POSE.isEnabled() ||
+                        !(packet instanceof net.minecraft.network.protocol.game.ClientboundSetEntityDataPacket(int id, List<net.minecraft.network.syncher.SynchedEntityData.DataValue<?>> packedItems))
+                ) {
+                    player.connection.send(packet);
+                    return;
+                }
+
+                if (this.entity.getId() != id) return; // Not self
+
+                final List<net.minecraft.network.syncher.SynchedEntityData.DataValue<?>> modifiedItems = new java.util.LinkedList<>(packedItems);
+                modifiedItems.removeIf(dataValue ->
+                        dataValue.id() == POSE_INDEX &&
+                                dataValue.value() instanceof net.minecraft.world.entity.Pose pose &&
+                                // Only remove STANDING and CROUCHING to avoid changing vanilla behavior
+                                (pose == net.minecraft.world.entity.Pose.STANDING || pose == net.minecraft.world.entity.Pose.CROUCHING)
+                );
+                if (modifiedItems.isEmpty()) return;
+                player.connection.send(new net.minecraft.network.protocol.game.ClientboundSetEntityDataPacket(id, modifiedItems));
+                // Lagless end - Implement pose module: cancel self pose updates
             }
         }
 
