--- /dev/null
+++ b/me/karven/lagless/command/LaglessCommand.java
@@ -0,0 +1,42 @@
+package me.karven.lagless.command;
+
+import com.mojang.brigadier.Command;
+import com.mojang.brigadier.CommandDispatcher;
+import me.karven.lagless.MinecraftLaglessMain;
+import net.minecraft.commands.CommandSourceStack;
+import net.minecraft.commands.Commands;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.TextColor;
+import net.minecraft.server.permissions.Permissions;
+
+public class LaglessCommand {
+    private static final Component RELOAD_CONFIG_SUCCESS_MESSAGE = Component.literal("Config reloaded successfully").withColor(TextColor.GREEN);
+    private static final Component RELOAD_CONFIG_FAILED_MESSAGE = Component.literal("Failed to reload config").withColor(TextColor.RED);
+
+
+    public static void register(final CommandDispatcher<CommandSourceStack> dispatcher) {
+        dispatcher.register(Commands.literal("lagless")
+                .requires(source -> source.hasPermission(Permissions.COMMANDS_GAMEMASTER, "lagless.command"))
+                .then(Commands.literal("reload")
+                        .requires(source -> source.hasPermission(Permissions.COMMANDS_GAMEMASTER, "lagless.command.reload"))
+                        .executes(context -> {
+                            MinecraftLaglessMain.instance().reloadConfigAsync().whenComplete((result, exception) -> {
+                                final CommandSourceStack source = context.getSource();
+                                if (exception != null) {
+                                    source.sendFailure(RELOAD_CONFIG_FAILED_MESSAGE);
+                                    return;
+                                }
+
+                                switch (result) {
+                                    case FAILED -> source.sendFailure(RELOAD_CONFIG_FAILED_MESSAGE);
+
+                                    case SUCCESS -> source.sendSuccess(() -> RELOAD_CONFIG_SUCCESS_MESSAGE, false);
+                                }
+                            });
+
+                            return Command.SINGLE_SUCCESS;
+                        })
+                )
+        );
+    }
+}
