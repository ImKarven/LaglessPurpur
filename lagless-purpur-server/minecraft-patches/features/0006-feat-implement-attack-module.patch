+    // Lagless start - Handle punch packet for attack module
+    private void handlePunchPacket$lagless() {
+        final me.karven.lagless.config.RootConfiguration config = me.karven.lagless.MinecraftLaglessMain.instance().config();
+        if (!me.karven.lagless.module.MinecraftLaglessModules.ATTACK.isEnabled(config)) return;
+
+        switch (this.player.getPunchState$lagless()) {
+            case ATTACK, INSTANT_BREAK -> {
+                // We shouldn't attack if the player broke a block with one punch
+                this.player.setPunchState$lagless(me.karven.lagless.module.AttackModule.PunchState.NONE);
+                return;
+            }
+
+            // TODO: bug: the client can continue breaking block even after abort
+            case DESTROYING_BLOCK -> {
+                return;
+            }
+
+            case START_DESTROY_BLOCK -> this.player.setPunchState$lagless(me.karven.lagless.module.AttackModule.PunchState.DESTROYING_BLOCK);
+        }
+
+        if (this.player.isSpectator() || !this.hasClientLoaded()) {
+            return;
+        }
+
+        final ItemStack mainHandItem = this.player.getMainHandItem();
+        if (this.player.cannotAttackWithItem(mainHandItem, 5)) {
+            return;
+        }
+
+        if (mainHandItem.has(DataComponents.PIERCING_WEAPON)) {
+            return;
+        }
+
+        final ServerLevel level = this.player.level();
+        if (!mainHandItem.isItemEnabled(level.enabledFeatures())) {
+            return;
+        }
+
+        final double range = this.player.entityInteractionRange();
+        final Location eyeLocation = this.getCraftPlayer().getEyeLocation();
+        final org.bukkit.util.RayTraceResult rayTraceResult = this.player.getBukkitEntity().getWorld().rayTrace(
+                eyeLocation,
+                eyeLocation.getDirection(),
+                range,
+                org.bukkit.FluidCollisionMode.NEVER,
+                false,
+                0,
+                entity -> {
+                    final CraftEntity craftEntity = (CraftEntity) entity;
+                    return !entity.getUniqueId().equals(this.player.getUUID()) &&
+                            (!(entity instanceof org.bukkit.entity.HumanEntity human) || human.getGameMode() != org.bukkit.GameMode.SPECTATOR) &&
+                            craftEntity.getHandle().isPickable() &&
+                            !craftEntity.getHandle().isPassengerOfSameVehicle(this.player) &&
+                            this.player.getBukkitEntity().canSee(entity);
+                }
+        );
+        if (rayTraceResult == null) return;
+        final org.bukkit.entity.Entity entity = rayTraceResult.getHitEntity();
+        if (entity == null) return;
+        final Entity mcEntity = ((CraftEntity) entity).getHandle();
+        if (!level.getWorldBorder().isWithinBounds(mcEntity.blockPosition())) {
+            return;
+        }
+        final boolean contain = config.modules.attack.entityTypes.entityTypes.contains(net.minecraft.world.entity.EntityType.getKey(mcEntity.getType()).toString());
+        switch (config.modules.attack.entityTypes.mode) {
+            case BLACKLIST -> {
+                if (contain) return;
+            }
+
+            case WHITELIST -> {
+                if (!contain) return;
+            }
+        }
+
+        // Attack the entity
+        this.handleAttack(new ServerboundAttackPacket(mcEntity.getId()));
+    }
+    // Lagless end - Handle punch packet for attack module
 
     @Override
     public void handlePunch(final ServerboundPunchPacket packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.player.level());
+        this.handlePunchPacket$lagless(); // Lagless - Handle punch packet for attack module
